# Dockerfile for CRDF FastAPI Backend
FROM python:3.12-slim

# Prevent Python from writing .pyc files and enable unbuffered logging
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Force matplotlib to use non-interactive Agg backend (no display server needed)
ENV MPLBACKEND=Agg

WORKDIR /app

# Install system dependencies:
#   - curl: for Docker HEALTHCHECK
#   - libfreetype6-dev, libpng-dev: required by matplotlib for chart rendering
#   - libjpeg62-turbo-dev: required by Pillow for JPEG support
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libfreetype6-dev \
    libpng-dev \
    libjpeg62-turbo-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --default-timeout=100 --retries=10 --no-cache-dir -r requirements.txt

# Copy application source code
COPY . .

# Expose FastAPI backend port
EXPOSE 8000

# Health check: verify the /health endpoint responds
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run via uvicorn with production settings
# - 2 workers for handling concurrent requests
# - Host 0.0.0.0 to accept connections from Docker network
CMD ["uvicorn", "web_app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
