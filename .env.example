# ===========================================
# CRDF System Environment Variables
# ===========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- Required API Keys ---
# Gemini API key for all LLM calls (CrewAI agents + multimodal checks)
GEMINI_API_KEY=

# Serper API key for web search tool used by research agents
SERPER_API_KEY=

# --- LLM Configuration ---
# Model identifier (e.g., gemini/gemini-2.0-flash, gemini/gemini-1.5-pro)
MODEL=gemini/gemini-2.0-flash

# --- Optional API Keys ---
# These are only needed if you switch MODEL to a non-Gemini provider
GROQ_API_KEY=
OPENAI_API_KEY=

# --- CrewAI Settings ---
CREWAI_TRACING_ENABLED=false

# --- Production Settings ---
# Comma-separated list of allowed CORS origins (defaults to localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost

# URL where the app is hosted (for self-referential links)
APP_URL=http://localhost
