"""
Standalone multimodal image authenticity checker for CRDF.

Uses CrewAI's native Python Agent/Task API (not the JSON declarative crew),
because the JSON crew format's input_files/{placeholder} substitution does
not reliably attach real image bytes to the LLM call in this CrewAI version.

Usage:
    python multimodal_image_check.py --claim "some claim text" --image path/to/image.png

If --image is omitted, outputs has_image: false with empty checks,
matching the behavior of the main JSON pipeline for consistency.
"""

import argparse
import json
import sys
from pathlib import Path

from crewai import Agent, Task, Crew


def build_image_agent() -> Agent:
    return Agent(
        role="Image and Visual Authenticity Analyst",
        goal=(
            "Check uploaded images for signs of manipulation such as lighting "
            "inconsistencies or compositing artifacts, and separately assess "
            "whether the image's actual content matches the claim it is "
            "attached to, keeping these two findings distinct from each other"
        ),
        backstory=(
            "A forensic image analyst who insists on separating two very "
            "different questions that people often confuse: whether an image "
            "has been technically altered, and whether an unaltered image is "
            "being used to falsely support a claim it has nothing to do with"
        ),
        llm="gemini/gemini-3.1-flash-lite",
        multimodal=True,  # still works in this version, just deprecated
        verbose=False,
        allow_delegation=False,
    )


def build_image_task(agent: Agent, claim: str, image_path: str) -> Task:
    return Task(
        description=(
            f"Perform two SEPARATE checks on the attached image and never "
            f"conflate them.\n\n"
            f"Check 1 - Manipulation: examine the image for technical signs "
            f"of editing such as lighting inconsistencies, cloning artifacts, "
            f"unnatural hard edges, or compositing seams, and state whether "
            f"it appears manipulated.\n\n"
            f"Check 2 - Content Match: independently assess whether what the "
            f"image actually shows matches this claim: \"{claim}\", "
            f"regardless of whether the image is manipulated or not. An "
            f"unedited real photo can still be irrelevant to or misused for "
            f"a claim, and a manipulated image could coincidentally still "
            f"depict something related to the claim.\n\n"
            f"You MUST actually look at the attached image content to answer "
            f"both checks with specific visual details you observe - do not "
            f"answer generically."
        ),
        expected_output=(
            "A JSON object with fields: has_image (boolean, true since an "
            "image is attached), manipulation_check (object with: "
            "appears_manipulated (boolean), reasoning (string, must "
            "reference specific visual details you observed)), "
            "content_match_check (object with: matches_claim (boolean or "
            "'undetermined'), reasoning (string))."
        ),
        agent=agent,
        multimodal=True,
    )


def run_image_check(claim: str, image_path: str | None) -> dict:
    if not image_path or image_path.strip().lower() == "none":
        return {
            "has_image": False,
            "manipulation_check": {"appears_manipulated": False, "reasoning": ""},
            "content_match_check": {"matches_claim": "undetermined", "reasoning": ""},
        }

    resolved = Path(image_path).expanduser().resolve()
    if not resolved.is_file():
        return {
            "has_image": False,
            "manipulation_check": {
                "appears_manipulated": False,
                "reasoning": f"File not found at {resolved}",
            },
            "content_match_check": {"matches_claim": "undetermined", "reasoning": ""},
        }

    # Phrases that indicate the model never actually received the image
    # (a known non-determinism in this CrewAI version's multimodal attach).
    FAILURE_SIGNALS = [
        "please provide", "please upload", "i don't see", "i do not see",
        "no image", "unable to view", "cannot view", "can't see",
    ]

    max_attempts = 3
    last_raw = ""
    for attempt in range(1, max_attempts + 1):
        agent = build_image_agent()
        task = build_image_task(agent, claim, str(resolved))
        task.description += f"\n\nImage file path to analyze: {resolved}"

        crew = Crew(agents=[agent], tasks=[task], verbose=False)
        result = crew.kickoff()
        raw = str(result)
        last_raw = raw

        cleaned = raw.strip()
        if cleaned.startswith("```"):
            cleaned = cleaned.split("```")[1]
            if cleaned.startswith("json"):
                cleaned = cleaned[4:]
        cleaned = cleaned.strip()

        lowered = cleaned.lower()
        if any(sig in lowered for sig in FAILURE_SIGNALS):
            continue  # image likely never attached - retry

        try:
            parsed = json.loads(cleaned)
            if parsed.get("has_image") is True:
                return parsed
            # has_image false/missing on an attempt where a real path was
            # given is also suspicious - retry rather than trust it blindly.
            continue
        except json.JSONDecodeError:
            continue

    # All attempts failed to produce a trustworthy result.
    return {
        "has_image": True,
        "manipulation_check": {"appears_manipulated": False, "reasoning": ""},
        "content_match_check": {"matches_claim": "undetermined", "reasoning": ""},
        "_raw_output": last_raw,
        "_parse_error": True,
        "_attempts_exhausted": max_attempts,
    }


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--claim", required=True)
    parser.add_argument("--image", default=None)
    args = parser.parse_args()

    output = run_image_check(args.claim, args.image)
    print(json.dumps(output, indent=2))


if __name__ == "__main__":
    main()
